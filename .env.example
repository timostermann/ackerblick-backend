# --- Application ---
PORT=3000

# --- Database (TimescaleDB / PostgreSQL) ---
# The DB image MUST be a TimescaleDB image (the schema creates hypertables).
# DB_USER / DB_PASSWORD / DB_NAME are used by docker-compose.prod.yml to configure
# the TimescaleDB container. They must match the credentials in DATABASE_URL.
DB_USER="ackerblick"
DB_PASSWORD="change-me-db-password"
DB_NAME="ackerblick"

# In production DATABASE_URL uses the 'db' service hostname (Docker network):
#   postgresql://<DB_USER>:<DB_PASSWORD>@db:5432/<DB_NAME>?schema=public
DATABASE_URL="postgresql://ackerblick:ackerblick@localhost:5432/ackerblick?schema=public"

# --- Firmware ingest auth (POST /readings) ---
# Single shared static key baked into firmware flash. Low-trust coarse gate.
API_KEY="change-me-ingest-key"

# --- Dashboard auth (GET /dashboard, HTTP Basic) ---
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="change-me-dashboard-password"

# Number of recent readings rendered on the dashboard.
DASHBOARD_READING_LIMIT=200
