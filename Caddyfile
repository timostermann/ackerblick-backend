api.ackerblick.com {
    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
    }
}
